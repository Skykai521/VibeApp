<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <package android:name="com.google.android.aicore" />
        <package android:name="com.google.android.as.oss" />
    </queries>

    <application
        android:name="com.vibe.app.presentation.VibeApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="upside_down_cake">
        <activity
            android:name="com.vibe.app.presentation.ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VibeApp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.vibe.app.feature.agent.service.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- DebugBridge: receives crash/log reports from installed generated apps.
             Must be exported (callers are separately-installed generated APKs); safety
             comes from DebugReportProvider verifying the caller's package prefix AND
             signing cert against the bundled testkey, not from a signature permission
             (VibeApp's release cert differs from the generated-app testkey). -->
        <provider
            android:name="com.vibe.app.plugin.DebugReportProvider"
            android:authorities="com.vibe.app.debugreport"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Invisible trampoline: launched from the "tap to preview" notification so the
             plugin container can start with foreground privileges from the main process. -->
        <activity
            android:name="com.vibe.app.plugin.PluginLaunchProxyActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- Plugin process slots (0-4): each in its own process with separate task affinity -->
        <activity
            android:name="com.vibe.app.plugin.PluginSlot0"
            android:process=":plugin0"
            android:taskAffinity="com.vibe.app.plugin0"
            android:launchMode="singleTask"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name="com.vibe.app.plugin.PluginSlot1"
            android:process=":plugin1"
            android:taskAffinity="com.vibe.app.plugin1"
            android:launchMode="singleTask"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name="com.vibe.app.plugin.PluginSlot2"
            android:process=":plugin2"
            android:taskAffinity="com.vibe.app.plugin2"
            android:launchMode="singleTask"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name="com.vibe.app.plugin.PluginSlot3"
            android:process=":plugin3"
            android:taskAffinity="com.vibe.app.plugin3"
            android:launchMode="singleTask"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name="com.vibe.app.plugin.PluginSlot4"
            android:process=":plugin4"
            android:taskAffinity="com.vibe.app.plugin4"
            android:launchMode="singleTask"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <!-- Plugin inspector services (0-4): each in matching plugin process -->
        <service
            android:name="com.vibe.app.plugin.PluginInspectorSlot0"
            android:process=":plugin0"
            android:exported="false" />
        <service
            android:name="com.vibe.app.plugin.PluginInspectorSlot1"
            android:process=":plugin1"
            android:exported="false" />
        <service
            android:name="com.vibe.app.plugin.PluginInspectorSlot2"
            android:process=":plugin2"
            android:exported="false" />
        <service
            android:name="com.vibe.app.plugin.PluginInspectorSlot3"
            android:process=":plugin3"
            android:exported="false" />
        <service
            android:name="com.vibe.app.plugin.PluginInspectorSlot4"
            android:process=":plugin4"
            android:exported="false" />
    </application>

</manifest>